<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToolSnap.Mobile.Pages.IncomingTransfersPage"
             Title="Transfers">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <!-- ── Incoming section ── -->
            <Label Text="Incoming Requests"
                   Style="{StaticResource PageTitleLabel}"
                   FontSize="22" />

            <Label x:Name="NoIncomingLabel"
                   Text="No pending incoming requests."
                   FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                   IsVisible="True" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding IncomingItems}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,4"
                                Padding="14"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardBg}, Dark={StaticResource CardBgDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource CardBorder}, Dark={StaticResource CardBorderDark}}">

                            <VerticalStackLayout Spacing="12">

                                <!-- Photo  |  Tool info -->
                                <Grid ColumnDefinitions="72,*"
                                      ColumnSpacing="12">

                                    <Border Grid.Column="0"
                                            WidthRequest="72"
                                            HeightRequest="72"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource PhotoBg}, Dark={StaticResource PhotoBgDark}}">
                                        <Grid>
                                            <Label Text="📷"
                                                   IsVisible="{Binding HasNoPhoto}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   FontSize="24"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                                            <Image Source="{Binding Photo}"
                                                   IsVisible="{Binding HasPhoto}"
                                                   Aspect="AspectFill" />
                                        </Grid>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1"
                                                         VerticalOptions="Center"
                                                         Spacing="4">

                                        <Label Text="{Binding ToolLabel}"
                                               FontAttributes="Bold"
                                               FontSize="15"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

                                        <Label Text="{Binding OtherUserName, StringFormat='From: {0}'}"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />

                                        <Label Text="{Binding InitiatedAtText}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />

                                    </VerticalStackLayout>

                                </Grid>

                                <!-- Accept / Reject -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <Button Grid.Column="0"
                                            Text="Accept"
                                            Style="{StaticResource SuccessButton}"
                                            CornerRadius="8"
                                            HeightRequest="42"
                                            Command="{Binding AcceptCommand}" />
                                    <Button Grid.Column="1"
                                            Text="Reject"
                                            Style="{StaticResource DestructiveButton}"
                                            CornerRadius="8"
                                            HeightRequest="42"
                                            Command="{Binding RejectCommand}" />
                                </Grid>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Divider -->
            <BoxView Style="{StaticResource Divider}" Margin="0,8" />

            <!-- ── Outgoing section ── -->
            <Label Text="My Outgoing Requests"
                   Style="{StaticResource PageTitleLabel}"
                   FontSize="22" />

            <Label x:Name="NoOutgoingLabel"
                   Text="No outgoing transfer requests."
                   FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                   IsVisible="True" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding OutgoingItems}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,4"
                                Padding="14"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardBg}, Dark={StaticResource CardBgDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource CardBorder}, Dark={StaticResource CardBorderDark}}">

                            <VerticalStackLayout Spacing="12">

                                <!-- Photo  |  Tool info -->
                                <Grid ColumnDefinitions="72,*"
                                      ColumnSpacing="12">

                                    <Border Grid.Column="0"
                                            WidthRequest="72"
                                            HeightRequest="72"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource PhotoBg}, Dark={StaticResource PhotoBgDark}}">
                                        <Grid>
                                            <Label Text="📷"
                                                   IsVisible="{Binding HasNoPhoto}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   FontSize="24"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                                            <Image Source="{Binding Photo}"
                                                   IsVisible="{Binding HasPhoto}"
                                                   Aspect="AspectFill" />
                                        </Grid>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1"
                                                         VerticalOptions="Center"
                                                         Spacing="4">

                                        <Label Text="{Binding ToolLabel}"
                                               FontAttributes="Bold"
                                               FontSize="15"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

                                        <Label Text="{Binding OtherUserName, StringFormat='To: {0}'}"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />

                                        <Label Text="{Binding Status}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource AccentOrange}, Dark={StaticResource AccentOrangeDark}}" />

                                        <Label Text="{Binding InitiatedAtText}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />

                                    </VerticalStackLayout>

                                </Grid>

                                <!-- Cancel — full width, only visible when Pending -->
                                <Button Text="Cancel Transfer"
                                        Style="{StaticResource DestructiveButton}"
                                        CornerRadius="8"
                                        HeightRequest="42"
                                        IsVisible="{Binding CanCancel}"
                                        HorizontalOptions="Fill"
                                        Command="{Binding CancelCommand}" />

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
