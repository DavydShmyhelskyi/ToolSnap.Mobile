<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToolSnap.Mobile.Pages.IncomingTransfersPage"
             Title="Transfers"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <!-- ─── Incoming section ─── -->
            <Label Text="Incoming Requests"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#222222" />

            <Label x:Name="NoIncomingLabel"
                   Text="No pending incoming requests."
                   FontSize="14"
                   TextColor="#999999"
                   IsVisible="True" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding IncomingItems}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,4"
                                Padding="14"
                                BackgroundColor="White"
                                Stroke="#E0E0E0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="6">

                                <Label Text="{Binding ToolLabel}"
                                       FontAttributes="Bold"
                                       FontSize="15"
                                       TextColor="#222222" />

                                <Label Text="{Binding OtherUserName, StringFormat='From: {0}'}"
                                       FontSize="13"
                                       TextColor="#555555" />

                                <Label Text="{Binding InitiatedAtText}"
                                       FontSize="12"
                                       TextColor="#999999" />

                                <Grid ColumnDefinitions="*,*"
                                      ColumnSpacing="10"
                                      Margin="0,6,0,0">
                                    <Button Text="Accept"
                                            BackgroundColor="#388E3C"
                                            TextColor="White"
                                            CornerRadius="8"
                                            HeightRequest="40"
                                            Command="{Binding AcceptCommand}" />
                                    <Button Grid.Column="1"
                                            Text="Reject"
                                            BackgroundColor="#D32F2F"
                                            TextColor="White"
                                            CornerRadius="8"
                                            HeightRequest="40"
                                            Command="{Binding RejectCommand}" />
                                </Grid>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- ─── Divider ─── -->
            <BoxView HeightRequest="1"
                     BackgroundColor="#DDDDDD"
                     Margin="0,8" />

            <!-- ─── Outgoing section ─── -->
            <Label Text="My Outgoing Requests"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#222222" />

            <Label x:Name="NoOutgoingLabel"
                   Text="No outgoing transfer requests."
                   FontSize="14"
                   TextColor="#999999"
                   IsVisible="True" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding OutgoingItems}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,4"
                                Padding="14"
                                BackgroundColor="White"
                                Stroke="#E0E0E0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="6">

                                <Label Text="{Binding ToolLabel}"
                                       FontAttributes="Bold"
                                       FontSize="15"
                                       TextColor="#222222" />

                                <Label Text="{Binding OtherUserName, StringFormat='To: {0}'}"
                                       FontSize="13"
                                       TextColor="#555555" />

                                <Label Text="{Binding Status}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#F57C00" />

                                <Label Text="{Binding InitiatedAtText}"
                                       FontSize="12"
                                       TextColor="#999999" />

                                <Button Text="Cancel"
                                        BackgroundColor="#F57C00"
                                        TextColor="White"
                                        CornerRadius="8"
                                        HeightRequest="40"
                                        IsVisible="{Binding CanCancel}"
                                        Command="{Binding CancelCommand}"
                                        HorizontalOptions="Start"
                                        Padding="20,0"
                                        Margin="0,6,0,0" />

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
