<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToolSnap.Mobile.Pages.HomePage">

    <ScrollView>
        <VerticalStackLayout Padding="30"
                             Spacing="25"
                             VerticalOptions="Center"
                             HorizontalOptions="Center">

            <Label Text="ToolSnap"
                   FontAttributes="Bold"
                   FontSize="30"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                   HorizontalOptions="Center"
                   Margin="0,10" />

            <Label Text="Choose an action"
                   FontSize="18"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20" />

            <Button Text="Open map"
                    HeightRequest="60"
                    WidthRequest="250"
                    FontSize="20"
                    CornerRadius="12"
                    Clicked="OnMapClicked" />

            <Button Text="Take a tool"
                    HeightRequest="60"
                    WidthRequest="250"
                    FontSize="20"
                    CornerRadius="12"
                    Style="{StaticResource SuccessButton}"
                    Clicked="OnTakeClicked" />

            <Button Text="Return a tool"
                    HeightRequest="60"
                    WidthRequest="250"
                    FontSize="20"
                    CornerRadius="12"
                    Clicked="OnReturnClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
