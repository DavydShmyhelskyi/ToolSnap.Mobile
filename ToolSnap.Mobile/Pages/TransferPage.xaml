<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToolSnap.Mobile.Pages.TransferPage"
             Title="Transfer Tool">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Transfer Tool"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#222222, Dark=#F0F0F0}" />

            <!-- Selected tool card -->
            <Border Padding="14"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3C}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                    <Border WidthRequest="64"
                            HeightRequest="64"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="{AppThemeBinding Light=#EEEEEE, Dark=#3A3A3C}">
                        <Image x:Name="ToolPhoto" Aspect="AspectFill" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1"
                                         VerticalOptions="Center"
                                         Spacing="4">
                        <Label x:Name="ToolTypeLabel"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light=#222222, Dark=#F0F0F0}" />
                        <Label x:Name="ToolSerialLabel"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light=#777777, Dark=#888888}" />
                    </VerticalStackLayout>

                </Grid>
            </Border>

            <!-- Recipient picker -->
            <Label Text="Select recipient"
                   FontSize="15"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#333333, Dark=#EEEEEE}" />

            <Border Padding="4"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3C}">
                <Picker x:Name="RecipientPicker"
                        Title="Choose a user..."
                        ItemsSource="{Binding Users}"
                        ItemDisplayBinding="{Binding FullName}"
                        SelectedIndexChanged="OnRecipientSelected" />
            </Border>

            <!-- Optional photo section -->
            <Label Text="Optional photo"
                   FontSize="15"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#333333, Dark=#EEEEEE}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Camera"
                        BackgroundColor="#1976D2"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="44"
                        Clicked="OnCameraClicked" />
                <Button Grid.Column="1"
                        Text="Gallery"
                        BackgroundColor="#455A64"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="44"
                        Clicked="OnGalleryClicked" />
            </Grid>

            <Border x:Name="PhotoPreviewBorder"
                    IsVisible="False"
                    HeightRequest="180"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{AppThemeBinding Light=#EEEEEE, Dark=#3A3A3C}">
                <Image x:Name="PhotoPreview" Aspect="AspectFit" />
            </Border>

            <!-- Confirm button -->
            <Button x:Name="ConfirmButton"
                    Text="Initiate Transfer"
                    HeightRequest="52"
                    FontSize="17"
                    CornerRadius="12"
                    BackgroundColor="#7B1FA2"
                    TextColor="White"
                    IsEnabled="False"
                    Clicked="OnConfirmClicked"
                    Margin="0,8,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
