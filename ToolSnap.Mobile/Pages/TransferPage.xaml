<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToolSnap.Mobile.Pages.TransferPage"
             Title="Transfer Tool">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Transfer Tool"
                   Style="{StaticResource PageTitleLabel}"
                   FontSize="24" />

            <!-- Selected tool card -->
            <Border Padding="14"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBg}, Dark={StaticResource CardBgDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource CardBorder}, Dark={StaticResource CardBorderDark}}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                    <Border WidthRequest="64"
                            HeightRequest="64"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PhotoBg}, Dark={StaticResource PhotoBgDark}}">
                        <Image x:Name="ToolPhoto" Aspect="AspectFill" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1"
                                         VerticalOptions="Center"
                                         Spacing="4">
                        <Label x:Name="ToolTypeLabel"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        <Label x:Name="ToolSerialLabel"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                    </VerticalStackLayout>

                </Grid>
            </Border>

            <!-- Recipient picker -->
            <Label Text="Select recipient"
                   Style="{StaticResource FieldLabel}"
                   FontSize="15" />

            <Border Padding="4"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBg}, Dark={StaticResource CardBgDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource CardBorder}, Dark={StaticResource CardBorderDark}}">
                <Picker x:Name="RecipientPicker"
                        Title="Choose a user..."
                        ItemsSource="{Binding Users}"
                        ItemDisplayBinding="{Binding FullName}"
                        SelectedIndexChanged="OnRecipientSelected" />
            </Border>

            <!-- Optional photo section -->
            <Label Text="Optional photo"
                   Style="{StaticResource FieldLabel}"
                   FontSize="15" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Camera"
                        CornerRadius="10"
                        HeightRequest="44"
                        Clicked="OnCameraClicked" />
                <Button Grid.Column="1"
                        Text="Gallery"
                        Style="{StaticResource SlateButton}"
                        CornerRadius="10"
                        HeightRequest="44"
                        Clicked="OnGalleryClicked" />
            </Grid>

            <Border x:Name="PhotoPreviewBorder"
                    IsVisible="False"
                    HeightRequest="180"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PhotoBg}, Dark={StaticResource PhotoBgDark}}">
                <Image x:Name="PhotoPreview" Aspect="AspectFit" />
            </Border>

            <!-- Confirm button -->
            <Button x:Name="ConfirmButton"
                    Text="Initiate Transfer"
                    HeightRequest="52"
                    FontSize="17"
                    CornerRadius="12"
                    Style="{StaticResource PurpleButton}"
                    IsEnabled="False"
                    Clicked="OnConfirmClicked"
                    Margin="0,8,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
