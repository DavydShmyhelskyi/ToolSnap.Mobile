<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToolSnap.Mobile.Pages.MapPage"
             Title="Map"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1F1F1F}">

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Padding="10"
          RowSpacing="0">

        <!-- Search bar -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="8"
              Margin="0,0,0,8">

            <SearchBar x:Name="SearchBar"
                       Grid.Column="0"
                       Placeholder="Search by name or serial number..."
                       SearchButtonPressed="OnSearchPressed" />

            <Button Text="Clear"
                    Grid.Column="1"
                    Padding="12,0"
                    Style="{StaticResource SecondaryButton}"
                    Clicked="OnClearSearch" />
        </Grid>

        <!-- Filter pickers -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*,*"
              ColumnSpacing="8"
              Margin="0,0,0,8">

            <Picker x:Name="ToolTypePicker"
                    Title="Type"
                    Grid.Column="0" />

            <Picker x:Name="BrandPicker"
                    Title="Brand"
                    Grid.Column="1" />

            <Picker x:Name="AvailabilityPicker"
                    Title="Status"
                    Grid.Column="2">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>All</x:String>
                        <x:String>Available</x:String>
                        <x:String>Not available</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
        </Grid>

        <!-- Map -->
        <Border Grid.Row="2"
                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3C}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}">
            <WebView x:Name="MapWebView" />
        </Border>

        <!-- Status bar: result count on the left, Next button on the right -->
        <Grid Grid.Row="3"
              ColumnDefinitions="*,Auto"
              Margin="0,8,0,0">

            <Label x:Name="ResultLabel"
                   Grid.Column="0"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light=Gray, Dark=#999999}"
                   FontSize="13" />

            <Button x:Name="NextButton"
                    Grid.Column="1"
                    Text="Next ›"
                    IsVisible="False"
                    Padding="16,8"
                    BackgroundColor="{AppThemeBinding Light=#E65100, Dark=#FF8A50}"
                    TextColor="White"
                    CornerRadius="8"
                    Clicked="OnNextClicked" />
        </Grid>

    </Grid>

</ContentPage>
