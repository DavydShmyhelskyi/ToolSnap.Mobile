<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToolSnap.Mobile.Pages.ConfirmOnTakeToolAsignmentPage"
             Title="Confirm Tools"
             BackgroundColor="#F5F5F5">

    <ContentPage.Content>

        <Grid RowDefinitions="*,Auto"
              Padding="15">

            <!-- LIST OF DETECTED TOOLS -->
            <CollectionView x:Name="ItemsCollectionView"
                            ItemsSource="{Binding Items}"
                            Grid.Row="0">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border Padding="12"
                                Margin="0,0,0,12"
                                Stroke="#CCCCCC"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="White">

                            <VerticalStackLayout Spacing="8">

                                <!-- TOOL TYPE -->
                                <Label Text="Tool Type"
                                       FontAttributes="Bold"
                                       TextColor="#333333" />
                                <Picker ItemsSource="{Binding ToolTypes}"
                                        ItemDisplayBinding="{Binding Title}"
                                        SelectedItem="{Binding SelectedToolType}"
                                        Title="Select tool type" />

                                <!-- BRAND -->
                                <Label Text="Brand"
                                       FontAttributes="Bold"
                                       TextColor="#333333" />
                                <Picker ItemsSource="{Binding Brands}"
                                        ItemDisplayBinding="{Binding Title}"
                                        SelectedItem="{Binding SelectedBrand}"
                                        Title="Select brand" />

                                <!-- MODEL -->
                                <Label Text="Model"
                                       FontAttributes="Bold"
                                       TextColor="#333333" />
                                <Picker ItemsSource="{Binding Models}"
                                        ItemDisplayBinding="{Binding Title}"
                                        SelectedItem="{Binding SelectedModel}"
                                        Title="Select model" />

                                <!-- TOOL -->
                                <Label Text="Tool"
                                       FontAttributes="Bold"
                                       TextColor="#333333" />
                                <Picker ItemsSource="{Binding Tools}"
                                        ItemDisplayBinding="{Binding SerialNumber}"
                                        SelectedItem="{Binding SelectedTool}"
                                        Title="Select tool" />

                                <!-- SERIAL NUMBER -->
                                <Label Text="Serial Number"
                                       FontAttributes="Bold"
                                       TextColor="#333333" />
                                <Entry Text="{Binding SerialNumber}"
                                       Placeholder="Enter serial number" />

                                <!-- CONFIDENCE -->
                                <Label Text="{Binding Confidence, StringFormat='Confidence: {0:F2}'}"
                                       FontSize="12"
                                       TextColor="Gray" />

                                <!-- PRICE -->
                                <Label Text="{Binding PriceText, StringFormat='Price: {0}'}"
                                       FontSize="12"
                                       TextColor="#1565C0"
                                       FontAttributes="Bold" />

                                <!-- DEADLINE (optional) -->
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="8"
                                      Margin="0,6,0,0">
                                    <Switch IsToggled="{Binding HasDeadline}"
                                            VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="Set return deadline"
                                           VerticalOptions="Center"
                                           TextColor="#333333" />
                                </Grid>
                                <DatePicker Date="{Binding DeadlineDate}"
                                            IsVisible="{Binding HasDeadline}"
                                            Format="dd MMM yyyy" />

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <!-- CONFIRM BUTTON -->
            <Button Text="Confirm"
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    Padding="12"
                    FontSize="18"
                    BackgroundColor="#388E3C"
                    TextColor="White"
                    CornerRadius="10"
                    Clicked="OnConfirmClicked" />

        </Grid>

    </ContentPage.Content>

</ContentPage>