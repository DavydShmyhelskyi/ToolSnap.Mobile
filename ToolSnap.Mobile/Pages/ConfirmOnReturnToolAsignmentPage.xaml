<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToolSnap.Mobile.Pages.ConfirmOnReturnToolAsignmentPage"
             Title="Confirm Return">

    <ContentPage.Content>

        <Grid RowDefinitions="*,Auto" Padding="15">

            <CollectionView x:Name="ItemsCollectionView"
                            ItemsSource="{Binding Items}"
                            Grid.Row="0">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border Padding="12"
                                Margin="0,0,0,12"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}"
                                Stroke="{AppThemeBinding Light=#CCCCCC, Dark=#3A3A3C}">

                            <VerticalStackLayout Spacing="8">

                                <Label Text="Tool Type"
                                       FontAttributes="Bold"
                                       Style="{StaticResource FieldLabel}" />
                                <Picker ItemsSource="{Binding ToolTypes}"
                                        ItemDisplayBinding="{Binding Title}"
                                        SelectedItem="{Binding SelectedToolType}"
                                        Title="Select tool type" />

                                <Label Text="Brand"
                                       FontAttributes="Bold"
                                       Style="{StaticResource FieldLabel}" />
                                <Picker ItemsSource="{Binding Brands}"
                                        ItemDisplayBinding="{Binding Title}"
                                        SelectedItem="{Binding SelectedBrand}"
                                        Title="Select brand" />

                                <Label Text="Model"
                                       FontAttributes="Bold"
                                       Style="{StaticResource FieldLabel}" />
                                <Picker ItemsSource="{Binding Models}"
                                        ItemDisplayBinding="{Binding Title}"
                                        SelectedItem="{Binding SelectedModel}"
                                        Title="Select model" />

                                <Label Text="Tool"
                                       FontAttributes="Bold"
                                       Style="{StaticResource FieldLabel}" />
                                <Picker ItemsSource="{Binding Tools}"
                                        ItemDisplayBinding="{Binding SerialNumber}"
                                        SelectedItem="{Binding SelectedTool}"
                                        Title="Select tool" />

                                <Label Text="Serial Number"
                                       FontAttributes="Bold"
                                       Style="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding SerialNumber}"
                                       Placeholder="Enter serial number" />

                                <Label Text="{Binding Confidence, StringFormat='Confidence: {0:F2}'}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=Gray, Dark=#999999}" />

                                <Label Text="{Binding PriceText, StringFormat='Price: {0}'}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#1565C0, Dark=#64B5F6}" />

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Button Text="Confirm Return"
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    Padding="12"
                    FontSize="18"
                    BackgroundColor="#F57C00"
                    TextColor="White"
                    CornerRadius="10"
                    Clicked="OnConfirmClicked" />

        </Grid>

    </ContentPage.Content>

</ContentPage>
