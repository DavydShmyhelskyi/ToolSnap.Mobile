<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToolSnap.Mobile.Pages.TakenToolsPage"
             Title="Taken Tools">

    <ContentPage.Content>
        <Grid RowDefinitions="Auto,Auto,*" Padding="16">

            <Label Grid.Row="0"
                   Text="Taken tools"
                   Style="{StaticResource PageTitleLabel}"
                   Margin="0,0,0,8" />

            <!-- Liability summary card -->
            <Border Grid.Row="1"
                    Margin="0,0,0,12"
                    Padding="14,10"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{AppThemeBinding Light={StaticResource WarmCardBg}, Dark={StaticResource WarmCardBgDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource WarmCardBorder}, Dark={StaticResource WarmCardBorderDark}}">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Total liability"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        <Label Text="{Binding TotalLiabilityText}"
                               Style="{StaticResource PriceLabel}"
                               FontSize="20" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1"
                           Text="{Binding ToolCountText}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Tool list -->
            <CollectionView Grid.Row="2"
                            x:Name="ToolsCollectionView"
                            ItemsSource="{Binding Tools}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,4"
                                Padding="10"
                                BackgroundColor="{Binding CardColor}"
                                Stroke="{Binding CardStroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12">

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                                <!-- Photo thumbnail -->
                                <Border WidthRequest="70"
                                        HeightRequest="70"
                                        Padding="0"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource PhotoBg}, Dark={StaticResource PhotoBgDark}}">
                                    <Image Source="{Binding Photo}" Aspect="AspectFill" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="4"
                                                     VerticalOptions="Center">

                                    <!-- Status chip -->
                                    <Border IsVisible="{Binding HasStatus}"
                                            BackgroundColor="{Binding StatusLabelColor}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 6"
                                            Padding="6,2"
                                            HorizontalOptions="Start">
                                        <Label Text="{Binding StatusLabel}"
                                               TextColor="White"
                                               FontSize="10"
                                               FontAttributes="Bold" />
                                    </Border>

                                    <Label Text="{Binding ToolTypeTitle}"
                                           FontAttributes="Bold"
                                           FontSize="16"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

                                    <Label Text="{Binding SerialNumber}"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />

                                    <Label Text="{Binding PriceText}"
                                           Style="{StaticResource PriceLabel}"
                                           FontSize="13" />

                                    <Label IsVisible="{Binding HasDeadline}"
                                           Text="{Binding DueAtText, StringFormat='Due: {0}'}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />

                                    <Button Text="Transfer"
                                            Style="{StaticResource PurpleButton}"
                                            CornerRadius="8"
                                            FontSize="13"
                                            HeightRequest="34"
                                            Padding="12,0"
                                            HorizontalOptions="Start"
                                            Command="{Binding TransferCommand}"
                                            Margin="0,4,0,0" />

                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </ContentPage.Content>
</ContentPage>
