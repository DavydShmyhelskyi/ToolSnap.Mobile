<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToolSnap.Mobile.Pages.TakenToolsPage"
             Title="Taken Tools"
             BackgroundColor="#F5F5F5">

    <ContentPage.Content>
        <Grid RowDefinitions="Auto,Auto,*"
              Padding="16">

            <!-- Заголовок всередині сторінки -->
            <Label Grid.Row="0"
                   Text="Taken tools"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#222222"
                   Margin="0,0,0,8" />

            <!-- Liability summary card -->
            <Border Grid.Row="1"
                    Margin="0,0,0,12"
                    Padding="14,10"
                    BackgroundColor="#E3F2FD"
                    Stroke="#90CAF9"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Total liability"
                               FontSize="12"
                               TextColor="#555555" />
                        <Label Text="{Binding TotalLiabilityText}"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#1565C0" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1"
                           Text="{Binding ToolCountText}"
                           FontSize="13"
                           TextColor="#777777"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Список інструментів -->
            <CollectionView Grid.Row="2"
                            x:Name="ToolsCollectionView"
                            ItemsSource="{Binding Tools}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <!-- Окрема картка -->
                        <Border Margin="0,4"
                                Padding="10"
                                BackgroundColor="{Binding CardColor}"
                                Stroke="{Binding CardStroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12">

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="12">

                                <!-- Фото -->
                                <Border WidthRequest="70"
                                        HeightRequest="70"
                                        Padding="0"
                                        StrokeThickness="0"
                                        BackgroundColor="#EEEEEE"
                                        StrokeShape="RoundRectangle 8">

                                    <Image Source="{Binding Photo}"
                                           Aspect="AspectFill" />
                                </Border>

                                <!-- Інфа про інструмент -->
                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="4"
                                                     VerticalOptions="Center">

                                    <!-- Status chip (overdue / due soon) -->
                                    <Border IsVisible="{Binding HasStatus}"
                                            BackgroundColor="{Binding StatusLabelColor}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 6"
                                            Padding="6,2"
                                            HorizontalOptions="Start">
                                        <Label Text="{Binding StatusLabel}"
                                               TextColor="White"
                                               FontSize="10"
                                               FontAttributes="Bold" />
                                    </Border>

                                    <!-- Тип інструменту -->
                                    <Label Text="{Binding ToolTypeTitle}"
                                           FontAttributes="Bold"
                                           FontSize="16"
                                           TextColor="#222222" />

                                    <!-- Серійний номер -->
                                    <Label Text="{Binding SerialNumber}"
                                           FontSize="14"
                                           TextColor="#777777" />

                                    <!-- Ціна -->
                                    <Label Text="{Binding PriceText}"
                                           FontSize="13"
                                           TextColor="#1565C0"
                                           FontAttributes="Bold" />

                                    <!-- Дедлайн -->
                                    <Label IsVisible="{Binding HasDeadline}"
                                           Text="{Binding DueAtText, StringFormat='Due: {0}'}"
                                           FontSize="12"
                                           TextColor="#555555" />

                                    <Button Text="Transfer"
                                            BackgroundColor="#7B1FA2"
                                            TextColor="White"
                                            CornerRadius="8"
                                            FontSize="13"
                                            HeightRequest="34"
                                            Padding="12,0"
                                            HorizontalOptions="Start"
                                            Command="{Binding TransferCommand}"
                                            Margin="0,4,0,0" />

                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </ContentPage.Content>
</ContentPage>