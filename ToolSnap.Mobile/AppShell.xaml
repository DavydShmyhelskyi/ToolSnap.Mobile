<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ToolSnap.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ToolSnap.Mobile"
    xmlns:pages="clr-namespace:ToolSnap.Mobile.Pages"
    Title="ToolSnap.Mobile">

    <!-- Flyout header — blue brand bar with a red badge when transfers are pending -->
    <Shell.FlyoutHeader>
        <VerticalStackLayout x:Name="FlyoutHeaderLayout"
                             BackgroundColor="#E65100"
                             Padding="20,28,20,18"
                             Spacing="0">

            <Label Text="ToolSnap"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="White" />

            <Border IsVisible="{Binding HasPendingTransfers}"
                    BackgroundColor="#E53935"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 10"
                    Padding="12,5"
                    Margin="0,10,0,0"
                    HorizontalOptions="Start">
                <Label Text="{Binding PendingTransfersBadgeText}"
                       TextColor="White"
                       FontSize="13"
                       FontAttributes="Bold" />
            </Border>

        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <ShellContent
        Title=""
        Shell.FlyoutBehavior="Disabled"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <FlyoutItem
        Title="Home"
        Route="home">
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate pages:HomePage}" />
    </FlyoutItem>

    <FlyoutItem
        Title="Profile"
        Route="profile">
        <ShellContent
            Route="profile1"
            Title="Profile"
            ContentTemplate="{DataTemplate pages:ProfilePage1}" />
    </FlyoutItem>

    <FlyoutItem
        Title="Taken Tools"
        Route="taken">
        <ShellContent
            Title="Taken Tools"
            ContentTemplate="{DataTemplate pages:TakenToolsPage}" />
    </FlyoutItem>

    <FlyoutItem
        Title="Transfers"
        Route="transfers">
        <ShellContent
            Title="Transfers"
            ContentTemplate="{DataTemplate pages:IncomingTransfersPage}" />
    </FlyoutItem>

    <FlyoutItem
        Title="Activity History"
        Route="activity">
        <ShellContent
            Title="Activity History"
            ContentTemplate="{DataTemplate pages:ActivityHistoryPage}" />
    </FlyoutItem>

</Shell>
